# Server-side .env for billsplit.arcan.uz.
#
# Lives ONLY on the VPS at <deploy path>/.env, chmod 600. It is never in git and
# never synced: the deploy rsync excludes it explicitly and omits --delete, so it
# survives every deploy. Fill it in COMPLETELY before the first PM2 start —
# src/config.ts validates with Zod and exits 1 on anything missing, which would
# burn PM2's max_restarts before you see a log line.

NODE_ENV=production
LOG_LEVEL=info

# From BotFather. This is the user-facing bot, NOT the deploy notifier.
BOT_TOKEN=CHANGE_ME

# Dedicated role and database — do not reuse a sibling project's.
# If the host is ever remote, this MUST carry ?sslmode=require.
DATABASE_URL=postgres://bill:CHANGE_ME@localhost:5432/bill_splitter

# 3000 (global-go), 3001 (Arcan prod) and 3002 (Arcan beta) are taken on this
# box. Must match the upstream in deploy/nginx/billsplit.arcan.uz.conf.
PORT=3003

# The public HTTPS origin. The bot reads this at boot to set the persistent
# "Open App" menu button, so it must match the certificate exactly.
WEBAPP_URL=https://billsplit.arcan.uz

# Absolute on purpose: the ./uploads default resolves against process.cwd(), and
# a pm2 resurrect at boot replays a saved cwd. Receipt and payment-proof images
# live here — it is user data, and nothing backs it up automatically.
UPLOAD_DIR=/home/behzodbek_abdurasulov/projects/bill-splitter/uploads
MAX_UPLOAD_BYTES=5000000

# Optional — receipt scanning stays disabled without it. Enabling it sends
# receipt images to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# REQUIRED. Generate with: openssl rand -hex 32
# Back it up off the server and outside the DB BEFORE first use — losing it makes
# every stored card permanently unreadable. See deploy/README.md.
CARD_ENCRYPTION_KEY=CHANGE_ME

# Only during a key rotation; see deploy/README.md. Leave unset otherwise.
# CARD_ENCRYPTION_KEY_PREVIOUS=

# Optional, comma-separated.
ADMIN_TELEGRAM_IDS=
