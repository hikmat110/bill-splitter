BOT_TOKEN=
DATABASE_URL=postgres://bill:bill@localhost:5432/bill_splitter
LOG_LEVEL=info
NODE_ENV=development
ADMIN_TELEGRAM_IDS=
# Public HTTPS origin of the Mini App (e.g. a cloudflared/ngrok tunnel in dev).
# Required for the bot's "Open App" web_app button.
WEBAPP_URL=
# HTTP port for the Mini App API / static server.
PORT=3000
# Directory for uploaded receipt/proof images. Use a persistent volume in prod.
UPLOAD_DIR=./uploads
# Max size of a single uploaded image, in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5000000
# Google AI Studio API key for receipt scanning (free tier works). Optional —
# the app boots without it and the "Scan receipt" feature stays disabled.
# Note: enabling this sends receipt images to Google's Gemini API.
GEMINI_API_KEY=
# Gemini model id used for receipt scanning. 2.5 Flash-Lite is closed to new
# projects (Google answers 404), so 3.5 is the default.
GEMINI_MODEL=gemini-3.5-flash-lite
# Only when Google rejects this machine's IP ("User location is not supported"):
# route the Gemini call through the relay in deploy/cloudflare/gemini-relay.js.
# GEMINI_BASE_URL=https://<name>.<account>.workers.dev
# GEMINI_RELAY_SECRET=
# Receipt-scan limits. Per user: at most N scans in any rolling window of H hours.
# Global: all users combined per Gemini free-tier day (resets midnight Pacific =
# 12:00 Tashkent in summer / 13:00 in winter); keep it under Google's 500 RPD.
# 0 = disabled. Comment out (don't leave empty — empty reads as 0) for defaults.
SCAN_RATE_LIMIT_PER_USER=6
SCAN_RATE_LIMIT_WINDOW_HOURS=24
SCAN_DAILY_GLOBAL_LIMIT=450
# Key for encrypting card numbers at rest. Generate with: openssl rand -hex 32
# Back it up outside the server — losing it makes stored cards unreadable.
CARD_ENCRYPTION_KEY=
# Only set while rotating CARD_ENCRYPTION_KEY (holds the old key during the
# re-encrypt window; see deploy/README.md). Leave unset otherwise.
# CARD_ENCRYPTION_KEY_PREVIOUS=
